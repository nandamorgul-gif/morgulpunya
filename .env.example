# Copy to .env (NEVER commit .env or real credentials)
NODE_ENV=development
PORT=3000
# Absolute path to persistent private SQLite data directory (not publicly served)
DATA_DIR=./runtime-data
# Set a strong password and a unique administrative email before first launch
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# Explicitly choose shipping amount in rupiah before enabling checkout.
# This is a DEMO flat delivery rate, not a courier quotation.
SHIPPING_FLAT_IDR=20000
# All products start with stock 0 unless admin changes them.
# For LOCAL sandbox demo only set this to 3 to seed inventory once.
SEED_DEMO_STOCK=0
# Midtrans server key is secret and MUST ONLY be held on the server.
# Without it, checkout is disabled, but catalog/admin can run.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
# Live mode additionally requires this explicit acknowledgement.
ENABLE_LIVE_PAYMENTS=false
# Uncomment only when deployed behind a trusted reverse proxy:
# TRUST_PROXY=1
